# No production secrets in git. Configure Cloudflare bindings via dashboard / wrangler secrets.
#
# Dev role headers for local API experimentation:
# X-Dev-Role=OFFICER
# X-Dev-Email=officer@example.local
#
# OQ-010 — when the client provides Access email → role mapping, set on Worker / local API:
# ACCESS_EMAIL_ROLE_MAP={"admin@example.gov.in":"ADMIN","officer@example.gov.in":"OFFICER"}
# ACCESS_ROLE_HEADER=X-Access-Role
#
# Staging raise (never commit the token). D1 edit + Pages edit on the client account:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CF_D1_PREVIEW_NAME=erode-exam-duty-preview
# CF_PAGES_PROJECT=erode-exam-duty
# CF_R2_PREVIEW_BUCKET=   # optional; leave unbound for stored:false backups
